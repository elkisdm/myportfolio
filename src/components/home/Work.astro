---
const projects = [
  {
    num: "/ 01",
    slug: "lead-scoring-engine",
    title: "Lead Scoring Engine",
    en: "Agents stopped reading at lead #50. And lead #51? Could've been the best one of the day. This engine reads all 800 and tiers each one in 30 seconds, so nobody finds gold in the trash again… because it never lands there.",
    es: "Los agentes dejaban de leer en el lead #50. ¿Y el #51? Podía ser el mejor del día. Este motor lee los 800 y le pone tier a cada uno en 30 segundos, para que nadie vuelva a encontrar oro en la basura… porque ya no cae ahí.",
    tags: ["Next.js", "Supabase", "GPT-4o-mini", "Edge functions"],
    company: "Capital Inteligente",
    stat: "42% conv. lift",
    statusEn: "In production · 2026",
    statusEs: "En producción · 2026",
    year: "2026",
  },
  {
    num: "/ 02",
    slug: "whatsapp-inbox-ai",
    title: "WhatsApp Inbox AI",
    en: "A 40-second voice note took 4 hours to answer. Now Whisper transcribes it, Vision reads the utility bill, and the draft is waiting when the agent opens the chat. The human only decides. That part I never automated.",
    es: "Una nota de voz de 40 segundos tomaba 4 horas en responderse. Ahora Whisper la transcribe, Vision lee la boleta, y el draft espera al agente cuando abre el chat. El humano solo decide. Esa parte nunca la automaticé.",
    tags: ["WhatsApp Cloud API", "Whisper", "Vision OCR"],
    company: "Capital Inteligente",
    stat: "3× agent throughput",
    statusEn: "In production · 2025",
    statusEs: "En producción · 2025",
    year: "2025",
  },
  {
    num: "/ 03",
    slug: "internal-admin-platform",
    title: "Internal Admin Platform",
    en: "\"Where does the data live?\" Sales said the Sheet. Ops said Notion. The truth was a screenshot lost in WhatsApp. Now there's one answer, and the monthly close went from a week to a day.",
    es: "\"¿Dónde está el dato?\" Ventas decía que en el Sheet. Ops decía que en Notion. La verdad era un pantallazo perdido en WhatsApp. Ahora hay una sola respuesta, y el cierre mensual pasó de una semana a un día.",
    tags: ["Astro 5", "TypeScript", "RBAC"],
    company: "Capital Inteligente",
    stat: "12 agents onboarded",
    statusEn: "In production · 2025",
    statusEs: "En producción · 2025",
    year: "2025",
  },
];
---

<section class="scope" id="work">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">
        <span class="ebar"></span>
        <span data-en>/ Featured work</span>
        <span data-es>/ Trabajo destacado</span>
        <span class="sep"></span>
        <b>03 projects</b>
      </div>
      <h2 class="section-title">
        <span data-en>Three stories that end in production.</span>
        <span data-es>Tres historias con final en producción.</span>
      </h2>
      <p class="section-lede">
        <span data-en>I could put a feature list here. But it's better if I tell you the problem each one had, because that's where the interesting part is.</span>
        <span data-es>Aquí podría ponerte una lista de features. Pero mejor te cuento el problema que tenía cada uno, porque ahí está lo interesante.</span>
      </p>
    </div>

    <div class="project-list">
      {projects.map((p) => (
        <a class="project-row" href={`/work/${p.slug}`}>
          <div class="pr-num">{p.num}</div>
          <div class="pr-main">
            <h3 class="pr-title">{p.title}</h3>
            <p class="pr-desc" data-en>{p.en}</p>
            <p class="pr-desc" data-es>{p.es}</p>
            <div class="pr-tags">
              {p.tags.map((t) => <span class="badge">{t}</span>)}
            </div>
          </div>
          <div class="pr-meta">
            <b>{p.company}</b>
            <span class="stat">{p.stat}</span><br />
            <span data-en>{p.statusEn}</span><span data-es>{p.statusEs}</span>
          </div>
          <div class="pr-year">{p.year}</div>
          <div class="pr-arrow">→</div>
        </a>
      ))}
    </div>

    <div class="project-list-foot">
      <span class="pl-foot-meta" data-en
        >More on /work — case studies, archived projects, side experiments.</span
      >
      <span class="pl-foot-meta" data-es
        >Más en /work — case studies, proyectos archivados, experimentos.</span
      >
      <a class="btn btn-ghost" href="/work">
        <span data-en>All projects</span><span data-es>Todos los proyectos</span>
        <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  section.scope {
    position: relative;
    padding: 140px 0 32px;
  }
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 72px;
    max-width: 880px;
  }
  .section-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(36px, 5.4vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0;
    color: var(--color-text-1);
  }
  .section-lede {
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-text-2);
    margin: 0;
    max-width: 60ch;
  }
  .section-lede b {
    color: var(--color-text-1);
    font-weight: 500;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-3);
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .eyebrow .ebar {
    display: inline-block;
    width: 3px;
    height: 11px;
    background: var(--color-accent);
    animation: blink 1.2s steps(2, start) infinite;
  }
  .eyebrow .sep {
    width: 16px;
    height: 1px;
    background: var(--color-hair-strong);
  }
  .eyebrow b {
    color: var(--color-text-1);
    font-weight: 500;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-hair);
  }
  .project-row {
    display: grid;
    grid-template-columns: 80px 1.6fr 1fr 90px 32px;
    gap: 32px;
    padding: 40px 0;
    border-bottom: 1px solid var(--color-hair);
    align-items: center;
    transition: background 180ms, padding 180ms;
    cursor: pointer;
    position: relative;
  }
  .project-row::before {
    content: "";
    position: absolute;
    left: -32px;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 60%;
    background: var(--color-accent);
    transition: width 220ms cubic-bezier(0.34, 1.2, 0.64, 1);
    box-shadow: 0 0 12px var(--accent-glow);
  }
  .project-row:hover {
    padding-left: 24px;
    background: linear-gradient(90deg, var(--color-surface-1), transparent 80%);
  }
  .project-row:hover::before {
    width: 3px;
  }
  .project-row:hover .pr-arrow {
    color: var(--color-accent);
    transform: translateX(6px);
  }
  .project-row:hover .pr-title {
    color: var(--color-accent-strong);
  }
  .pr-num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-3);
    letter-spacing: 0.06em;
  }
  .pr-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pr-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--color-text-1);
    margin: 0;
    transition: color 180ms;
  }
  .pr-desc {
    font-size: 14.5px;
    color: var(--color-text-2);
    line-height: 1.55;
    margin: 0;
    max-width: 56ch;
  }
  .pr-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .pr-meta {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-3);
    letter-spacing: 0.06em;
    line-height: 1.6;
  }
  .pr-meta b {
    color: var(--color-text-1);
    display: block;
    font-weight: 500;
  }
  .pr-meta .stat {
    color: var(--color-accent);
  }
  .pr-year {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.02em;
    color: var(--color-text-2);
    text-align: right;
  }
  .pr-arrow {
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--color-text-3);
    transition: color 180ms, transform 180ms;
  }

  .project-list-foot {
    padding: 32px 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pl-foot-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 14.5px;
    padding: 14px 22px;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-text-1);
    cursor: pointer;
    transition: color 180ms;
  }
  .btn-ghost {
    color: var(--color-text-2);
  }
  .btn-ghost:hover {
    color: var(--color-text-1);
  }
  .btn .arrow {
    font-family: var(--font-mono);
    transition: transform 180ms;
  }
  .btn:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 1024px) {
    .project-row {
      grid-template-columns: 60px 1fr auto 24px;
      gap: 20px;
    }
    .project-row .pr-meta {
      display: none;
    }
  }
  @media (max-width: 720px) {
    section.scope {
      padding: 80px 0 16px;
    }
    .project-row {
      grid-template-columns: 40px 1fr 20px;
      gap: 12px;
      padding: 28px 0;
    }
    .pr-year,
    .pr-tags {
      display: none;
    }
    .pr-title {
      font-size: 22px;
    }
  }
</style>
