---
const projects = [
  {
    num: "/ 01",
    title: "Lead Scoring Engine",
    en: "Cross-references feasibility, budget signals, and behavioral history. WhatsApp inbound → tiered score in <30 s. Built for Capital Inteligente.",
    es: "Cruza factibilidad, señales de presupuesto e historial. WhatsApp inbound → score tiered en <30 s. Para Capital Inteligente.",
    tags: ["Next.js", "Supabase", "GPT-4o-mini", "Edge functions"],
    company: "Capital Inteligente",
    stat: "42% conv. lift",
    statusEn: "In production · 2026",
    statusEs: "En producción · 2026",
    year: "2026",
  },
  {
    num: "/ 02",
    title: "WhatsApp Inbox AI",
    en: "AI-augmented agent console. Whisper transcription, Vision OCR, GPT-4o-mini draft replies. Automated address normalization + 60-day feasibility cache.",
    es: "Consola de agentes con IA. Transcripción Whisper, OCR Vision, drafts GPT-4o-mini. Normalización de direcciones + cache de factibilidad 60 días.",
    tags: ["WhatsApp Cloud API", "Whisper", "Vision OCR"],
    company: "Capital Inteligente",
    stat: "3× agent throughput",
    statusEn: "In production · 2025",
    statusEs: "En producción · 2025",
    year: "2025",
  },
  {
    num: "/ 03",
    title: "Internal Admin Platform",
    en: "Dashboard for ops + sales: lead pipeline, agent performance, factibilidad coverage, CSV import, role-based access. Built solo over a quarter.",
    es: "Dashboard para ops + ventas: pipeline de leads, performance de agentes, cobertura de factibilidad, import CSV, RBAC. Construido solo en un trimestre.",
    tags: ["Astro 5", "TypeScript", "RBAC"],
    company: "Capital Inteligente",
    stat: "12 agents onboarded",
    statusEn: "In production · 2025",
    statusEs: "En producción · 2025",
    year: "2025",
  },
];
---

<section class="scope" id="work">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">
        <span class="ebar"></span>
        <span data-en>/ Featured work</span>
        <span data-es>/ Trabajo destacado</span>
        <span class="sep"></span>
        <b>03 projects</b>
      </div>
      <h2 class="section-title">
        <span data-en>Built end-to-end.</span>
        <span data-es>Construido end-to-end.</span>
      </h2>
      <p class="section-lede">
        <span data-en>Each one started as a business problem. Each one shipped to production. No design-only mockups, no abandoned demos.</span>
        <span data-es>Cada uno empezó como un problema de negocio. Cada uno llegó a producción. Sin mockups de solo diseño, sin demos abandonadas.</span>
      </p>
    </div>

    <div class="project-list">
      {projects.map((p) => (
        <a class="project-row" href="#">
          <div class="pr-num">{p.num}</div>
          <div class="pr-main">
            <h3 class="pr-title">{p.title}</h3>
            <p class="pr-desc" data-en>{p.en}</p>
            <p class="pr-desc" data-es>{p.es}</p>
            <div class="pr-tags">
              {p.tags.map((t) => <span class="badge">{t}</span>)}
            </div>
          </div>
          <div class="pr-meta">
            <b>{p.company}</b>
            <span class="stat">{p.stat}</span><br />
            <span data-en>{p.statusEn}</span><span data-es>{p.statusEs}</span>
          </div>
          <div class="pr-year">{p.year}</div>
          <div class="pr-arrow">→</div>
        </a>
      ))}
    </div>

    <div class="project-list-foot">
      <span class="pl-foot-meta" data-en
        >More on /work — case studies, archived projects, side experiments.</span
      >
      <span class="pl-foot-meta" data-es
        >Más en /work — case studies, proyectos archivados, experimentos.</span
      >
      <a class="btn btn-ghost" href="/work">
        <span data-en>All projects</span><span data-es>Todos los proyectos</span>
        <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  section.scope {
    position: relative;
    padding: 140px 0 32px;
  }
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 72px;
    max-width: 880px;
  }
  .section-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(36px, 5.4vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0;
    color: var(--color-text-1);
  }
  .section-lede {
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-text-2);
    margin: 0;
    max-width: 60ch;
  }
  .section-lede b {
    color: var(--color-text-1);
    font-weight: 500;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-3);
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .eyebrow .ebar {
    display: inline-block;
    width: 3px;
    height: 11px;
    background: var(--color-accent);
    animation: blink 1.2s steps(2, start) infinite;
  }
  .eyebrow .sep {
    width: 16px;
    height: 1px;
    background: var(--color-hair-strong);
  }
  .eyebrow b {
    color: var(--color-text-1);
    font-weight: 500;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-hair);
  }
  .project-row {
    display: grid;
    grid-template-columns: 80px 1.6fr 1fr 90px 32px;
    gap: 32px;
    padding: 40px 0;
    border-bottom: 1px solid var(--color-hair);
    align-items: center;
    transition: background 180ms, padding 180ms;
    cursor: pointer;
    position: relative;
  }
  .project-row::before {
    content: "";
    position: absolute;
    left: -32px;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 60%;
    background: var(--color-accent);
    transition: width 220ms cubic-bezier(0.34, 1.2, 0.64, 1);
    box-shadow: 0 0 12px var(--accent-glow);
  }
  .project-row:hover {
    padding-left: 24px;
    background: linear-gradient(90deg, var(--color-surface-1), transparent 80%);
  }
  .project-row:hover::before {
    width: 3px;
  }
  .project-row:hover .pr-arrow {
    color: var(--color-accent);
    transform: translateX(6px);
  }
  .project-row:hover .pr-title {
    color: var(--color-accent-strong);
  }
  .pr-num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-3);
    letter-spacing: 0.06em;
  }
  .pr-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pr-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--color-text-1);
    margin: 0;
    transition: color 180ms;
  }
  .pr-desc {
    font-size: 14.5px;
    color: var(--color-text-2);
    line-height: 1.55;
    margin: 0;
    max-width: 56ch;
  }
  .pr-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .pr-meta {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-3);
    letter-spacing: 0.06em;
    line-height: 1.6;
  }
  .pr-meta b {
    color: var(--color-text-1);
    display: block;
    font-weight: 500;
  }
  .pr-meta .stat {
    color: var(--color-accent);
  }
  .pr-year {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.02em;
    color: var(--color-text-2);
    text-align: right;
  }
  .pr-arrow {
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--color-text-3);
    transition: color 180ms, transform 180ms;
  }

  .project-list-foot {
    padding: 32px 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pl-foot-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 14.5px;
    padding: 14px 22px;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-text-1);
    cursor: pointer;
    transition: color 180ms;
  }
  .btn-ghost {
    color: var(--color-text-2);
  }
  .btn-ghost:hover {
    color: var(--color-text-1);
  }
  .btn .arrow {
    font-family: var(--font-mono);
    transition: transform 180ms;
  }
  .btn:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 1024px) {
    .project-row {
      grid-template-columns: 60px 1fr auto 24px;
      gap: 20px;
    }
    .project-row .pr-meta {
      display: none;
    }
  }
  @media (max-width: 720px) {
    section.scope {
      padding: 80px 0 16px;
    }
    .project-row {
      grid-template-columns: 40px 1fr 20px;
      gap: 12px;
      padding: 28px 0;
    }
    .pr-year,
    .pr-tags {
      display: none;
    }
    .pr-title {
      font-size: 22px;
    }
  }
</style>
