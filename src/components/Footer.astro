---
// Minimal footer matching design.
---

<footer>
  <div class="container foot-inner">
    <div class="foot-mark"><span class="bar"></span>elkis daza</div>
    <div>
      <span data-en
        >© 2026 · Last updated <b>May 27, 2026</b> · Built in Astro + GSAP</span
      >
      <span data-es
        >© 2026 · Actualizado <b>27 mayo 2026</b> · Construido en Astro + GSAP</span
      >
    </div>
    <div class="foot-links">
      <a href="/rss.xml">RSS</a>
      <span>·</span>
      <a href="/uses">/uses</a>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 48px 0 56px;
    border-top: 1px solid var(--color-hair);
  }
  .foot-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-text-3);
    letter-spacing: 0.04em;
  }
  .foot-inner b {
    color: var(--color-text-2);
    font-weight: 500;
  }
  .foot-mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 14px;
    color: var(--color-text-2);
    letter-spacing: -0.01em;
  }
  .foot-mark .bar {
    display: inline-block;
    width: 3px;
    height: 14px;
    background: var(--color-accent);
    animation: blink 1.2s steps(2, start) infinite;
  }
  .foot-links a {
    border-bottom: 1px solid var(--color-hair-strong);
    padding-bottom: 1px;
  }
</style>
