---
// Sticky nav with brand bar, language toggle, status indicator.
// Behavior wired in BaseLayout's <script> tag.
---

<nav class="nav" id="nav">
  <div class="nav-inner">
    <a class="nav-brand" href="#hero">
      <span class="bar"></span>elkis <span class="last">daza</span>
    </a>
    <div class="nav-links">
      <a class="nav-link active" data-target="hero">Home</a>
      <a class="nav-link" data-target="work" data-en>Work</a>
      <a class="nav-link" data-target="work" data-es>Trabajo</a>
      <a class="nav-link" data-target="methodology" data-en>Method</a>
      <a class="nav-link" data-target="methodology" data-es>Método</a>
      <a class="nav-link" data-target="contact" data-en>Contact</a>
      <a class="nav-link" data-target="contact" data-es>Contacto</a>
    </div>
    <div class="nav-right">
      <span class="nav-status" data-en>Available · Q3 2026</span>
      <span class="nav-status" data-es>Disponible · Q3 2026</span>
      <div class="lang-toggle" id="langToggle">
        <button data-lang="en" class="on">EN</button>
        <button data-lang="es">ES</button>
      </div>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(10, 10, 11, 0.7);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms, background 200ms;
  }
  .nav.scrolled {
    background: rgba(10, 10, 11, 0.88);
    border-bottom-color: var(--color-hair);
  }
  .nav-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 18px 32px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    letter-spacing: -0.02em;
    color: var(--color-text-1);
  }
  .nav-brand .bar {
    display: inline-block;
    width: 4px;
    height: 17px;
    background: var(--color-accent);
    animation: blink 1.2s steps(2, start) infinite;
    box-shadow: 0 0 12px var(--accent-glow);
  }
  .nav-brand .last {
    color: var(--color-text-3);
    font-weight: 400;
  }
  .nav-links {
    display: inline-flex;
    gap: 4px;
    padding: 5px;
    background: rgba(22, 22, 26, 0.6);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-full);
  }
  .nav-link {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 13px;
    color: var(--color-text-2);
    padding: 7px 14px;
    border-radius: var(--radius-full);
    transition: background 150ms, color 150ms;
    cursor: pointer;
  }
  .nav-link:hover {
    color: var(--color-text-1);
  }
  .nav-link.active {
    background: var(--color-bg);
    color: var(--color-text-1);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .nav-link.active::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--accent-glow);
  }
  .nav-right {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .nav-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-2);
    letter-spacing: 0.06em;
  }
  .nav-status::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 10px var(--accent-glow);
    animation: pulse-glow 2s ease-in-out infinite;
  }
  .lang-toggle {
    display: inline-flex;
    padding: 4px;
    background: rgba(22, 22, 26, 0.6);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-full);
  }
  .lang-toggle button {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-text-3);
    background: transparent;
    border: 0;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    cursor: pointer;
    letter-spacing: 0.06em;
    transition: background 150ms, color 150ms;
  }
  .lang-toggle button.on {
    background: var(--color-bg);
    color: var(--color-text-1);
  }

  @media (max-width: 720px) {
    .nav-inner {
      padding: 14px 20px;
      grid-template-columns: 1fr auto;
    }
    .nav-links {
      display: none;
    }
  }
</style>
