---
// Sticky nav with brand bar, language toggle, status indicator.
// Active state determined by pathname (SSR), NOT by scroll position.
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const startsWith = (p: string) => pathname === p || pathname.startsWith(p + "/");
const isEs = pathname === "/es" || pathname.startsWith("/es/");
const active = {
  home: pathname === "/" || pathname === "/es",
  work: startsWith("/work"),
  blog: startsWith("/blog"),
  about: startsWith("/about"),
};
---

<nav class="nav" id="nav">
  <div class="nav-inner">
    <a class="nav-brand" href="/">
      <span class="bar"></span>elkis <span class="last">daza</span>
    </a>

    <div class="nav-links">
      <a class={`nav-link${active.home ? " active" : ""}`} href="/" data-en>Home</a>
      <a class={`nav-link${active.home ? " active" : ""}`} href="/" data-es>Inicio</a>
      <a class={`nav-link${active.work ? " active" : ""}`} href="/work" data-en>Work</a>
      <a class={`nav-link${active.work ? " active" : ""}`} href="/work" data-es>Trabajo</a>
      <a class={`nav-link${active.blog ? " active" : ""}`} href="/blog" data-en>Blog</a>
      <a class={`nav-link${active.blog ? " active" : ""}`} href="/blog" data-es>Blog</a>
      <a class={`nav-link${active.about ? " active" : ""}`} href="/about" data-en>About</a>
      <a class={`nav-link${active.about ? " active" : ""}`} href="/about" data-es>Sobre mí</a>
    </div>

    <div class="nav-right">
      <span class="nav-status" data-en>Available · Q3 2026</span>
      <span class="nav-status" data-es>Disponible · Q3 2026</span>
      <div class="lang-toggle" id="langToggle">
        <button data-lang="en" class={isEs ? "" : "on"}>EN</button>
        <button data-lang="es" class={isEs ? "on" : ""}>ES</button>
      </div>
      <button
        class="nav-burger"
        id="navBurger"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="nav-drawer" id="navDrawer" aria-hidden="true">
    <div class="drawer-inner">
      <a class="drawer-link" href="/" data-en>Home</a>
      <a class="drawer-link" href="/" data-es>Inicio</a>
      <a class="drawer-link" href="/work" data-en>Work</a>
      <a class="drawer-link" href="/work" data-es>Trabajo</a>
      <a class="drawer-link" href="/blog" data-en>Blog</a>
      <a class="drawer-link" href="/blog" data-es>Blog</a>
      <a class="drawer-link" href="/about" data-en>About</a>
      <a class="drawer-link" href="/about" data-es>Sobre mí</a>
      <a class="drawer-link" href="/now">/now</a>
      <a class="drawer-link" href="/uses">/uses</a>
      <a class="drawer-link" href="/view-source">/view-source</a>
    </div>
  </div>
</nav>

<script>
  // Idempotent init — safe to call multiple times across View Transitions.
  function initBurger() {
    const burger = document.getElementById("navBurger") as
      | HTMLButtonElement
      | null;
    const drawer = document.getElementById("navDrawer");
    if (!burger || !drawer) return;
    if (burger.dataset.bound === "true") return;
    burger.dataset.bound = "true";

    const toggle = (open?: boolean) => {
      const willOpen =
        typeof open === "boolean" ? open : !drawer.classList.contains("open");
      drawer.classList.toggle("open", willOpen);
      burger.classList.toggle("open", willOpen);
      burger.setAttribute("aria-expanded", String(willOpen));
      drawer.setAttribute("aria-hidden", String(!willOpen));
      document.body.style.overflow = willOpen ? "hidden" : "";
    };

    burger.addEventListener("click", () => toggle());
    drawer
      .querySelectorAll<HTMLAnchorElement>("a.drawer-link")
      .forEach((a) => a.addEventListener("click", () => toggle(false)));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") toggle(false);
    });
  }

  initBurger();
  document.addEventListener("astro:page-load", initBurger);
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(10, 10, 11, 0.7);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms, background 200ms;
  }
  .nav.scrolled {
    background: rgba(10, 10, 11, 0.88);
    border-bottom-color: var(--color-hair);
  }
  .nav-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 18px 32px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    letter-spacing: -0.02em;
    color: var(--color-text-1);
  }
  .nav-brand .bar {
    display: inline-block;
    width: 4px;
    height: 17px;
    background: var(--color-accent);
    animation: blink 1.2s steps(2, start) infinite;
    box-shadow: 0 0 12px var(--accent-glow);
  }
  .nav-brand .last {
    color: var(--color-text-3);
    font-weight: 400;
  }

  .nav-links {
    display: inline-flex;
    gap: 4px;
    padding: 5px;
    background: rgba(22, 22, 26, 0.6);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-full);
  }
  .nav-link {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 13px;
    color: var(--color-text-2);
    padding: 7px 14px;
    border-radius: var(--radius-full);
    transition: background 150ms, color 150ms;
    cursor: pointer;
  }
  .nav-link:hover {
    color: var(--color-text-1);
  }
  .nav-link.active {
    background: var(--color-bg);
    color: var(--color-text-1);
    align-items: center;
    gap: 6px;
  }
  .nav-link.active::before {
    content: "";
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--accent-glow);
  }
  /* i18n hide must win over .active — use !important to defeat the active rule.
     Without this, an .active link with data-es would still show when EN is on. */
  html:not([data-lang='es']) .nav-link[data-es],
  html:not([data-lang='es']) .drawer-link[data-es] {
    display: none !important;
  }
  html[data-lang='es'] .nav-link[data-en],
  html[data-lang='es'] .drawer-link[data-en] {
    display: none !important;
  }
  .nav-right {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .nav-status {
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-2);
    letter-spacing: 0.06em;
  }
  .nav-status[data-en],
  .nav-status[data-es] {
    /* Display managed by global i18n rules */
  }
  .nav-status::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 10px var(--accent-glow);
    animation: pulse-glow 2s ease-in-out infinite;
    margin-right: 6px;
    vertical-align: middle;
  }
  .lang-toggle {
    display: inline-flex;
    padding: 4px;
    background: rgba(22, 22, 26, 0.6);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-full);
  }
  .lang-toggle button {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-text-3);
    background: transparent;
    border: 0;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    cursor: pointer;
    letter-spacing: 0.06em;
    transition: background 150ms, color 150ms;
  }
  .lang-toggle button.on {
    background: var(--color-bg);
    color: var(--color-text-1);
  }

  /* Hamburger button — hidden on desktop */
  .nav-burger {
    display: none;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-md);
    padding: 0;
    cursor: pointer;
    position: relative;
  }
  .nav-burger span {
    position: absolute;
    left: 9px;
    width: 18px;
    height: 1.5px;
    background: var(--color-text-1);
    transition: transform 200ms ease, opacity 200ms ease, top 200ms ease;
  }
  .nav-burger span:nth-child(1) {
    top: 12px;
  }
  .nav-burger span:nth-child(2) {
    top: 17px;
  }
  .nav-burger span:nth-child(3) {
    top: 22px;
  }
  .nav-burger.open span:nth-child(1) {
    top: 17px;
    transform: rotate(45deg);
  }
  .nav-burger.open span:nth-child(2) {
    opacity: 0;
  }
  .nav-burger.open span:nth-child(3) {
    top: 17px;
    transform: rotate(-45deg);
  }

  /* Mobile drawer */
  .nav-drawer {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(10, 10, 11, 0.97);
    backdrop-filter: blur(20px);
    z-index: 49;
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
    display: none;
  }
  .nav-drawer.open {
    opacity: 1;
    pointer-events: auto;
  }
  .drawer-inner {
    padding: 100px 32px 40px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 480px;
    margin: 0 auto;
  }
  .drawer-link {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 28px;
    letter-spacing: -0.025em;
    color: var(--color-text-1);
    padding: 14px 0;
    border-bottom: 1px solid var(--color-hair);
    transition: color 150ms;
  }
  .drawer-link:hover,
  .drawer-link:active {
    color: var(--color-accent);
  }
  .drawer-link[href^="/"][href*="/"]:not([href="/"]) {
    /* placeholder for sub-route styling */
  }

  @media (max-width: 900px) {
    .nav-status {
      display: none !important;
    }
  }

  @media (max-width: 720px) {
    .nav-inner {
      padding: 14px 20px;
      grid-template-columns: 1fr auto;
    }
    .nav-links {
      display: none !important;
    }
    .nav-burger {
      display: inline-block;
    }
    .nav-drawer {
      display: block;
    }
  }
</style>
