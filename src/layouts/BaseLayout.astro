---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import NoiseOverlay from "../components/NoiseOverlay.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: "en" | "es";
}

const {
  title = "elkis.dev — Product engineer",
  description = "Elkis Daza Mota — Product Engineer. I spot the business problem. I build the full solution.",
  ogImage = "/og-default.png",
  lang: langProp,
} = Astro.props;

// Auto-detect language from URL: /es/* routes default to ES, everything else EN.
// Can be overridden via the lang prop.
const pathname = Astro.url.pathname;
const lang: "en" | "es" =
  langProp ?? (pathname === "/es" || pathname.startsWith("/es/") ? "es" : "en");

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <NoiseOverlay />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import { initAnimations } from "../scripts/animations";
      import { logConsoleArt } from "../scripts/console-art";

      const LANG_KEY = "elkis.lang";

      function setLang(l: string) {
        document.documentElement.setAttribute("data-lang", l);
        document.documentElement.setAttribute("lang", l);
        const lt = document.getElementById("langToggle");
        lt?.querySelectorAll<HTMLButtonElement>("button").forEach((b) => {
          b.classList.toggle("on", b.dataset.lang === l);
        });
        try {
          localStorage.setItem(LANG_KEY, l);
        } catch (_) {
          /* noop */
        }
      }

      function setup() {
        const nav = document.getElementById("nav");

        // Sticky border on scroll only (no scroll-spy — active state is
        // set in SSR by pathname in Nav.astro).
        const onScroll = () => {
          if (!nav) return;
          nav.classList.toggle("scrolled", window.scrollY > 16);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        // Smooth scroll for hash links within the current page
        document
          .querySelectorAll<HTMLAnchorElement>('a[href^="#"]')
          .forEach((a) => {
            a.addEventListener("click", (e) => {
              const id = a.getAttribute("href")?.slice(1);
              if (!id) return;
              const el = document.getElementById(id);
              if (el) {
                e.preventDefault();
                el.scrollIntoView({ behavior: "smooth", block: "start" });
              }
            });
          });

        // Language toggle (persisted)
        const lt = document.getElementById("langToggle");
        lt?.querySelectorAll<HTMLButtonElement>("button").forEach((b) => {
          b.addEventListener("click", () => {
            if (b.dataset.lang) setLang(b.dataset.lang);
          });
        });
        // SSR is the source of truth when the URL is explicitly localized.
        // Otherwise restore the user's last toggle choice from localStorage.
        const ssrLang = document.documentElement.getAttribute("data-lang");
        const urlIsLocalized =
          location.pathname === "/es" || location.pathname.startsWith("/es/");
        try {
          if (urlIsLocalized && ssrLang) {
            localStorage.setItem(LANG_KEY, ssrLang);
          } else {
            const s = localStorage.getItem(LANG_KEY);
            if (s) setLang(s);
          }
        } catch (_) {
          /* noop */
        }

        // Wow factors: animations + console art
        initAnimations();
      }

      // Initial load
      setup();
      logConsoleArt();

      // Re-init after Astro View Transitions navigations
      document.addEventListener("astro:page-load", setup);
    </script>
  </body>
</html>
